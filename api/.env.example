# ===============================
# CENARIO 1: DESENVOLVIMENTO LOCAL
# ===============================
# Use NODE_ENV=development para permitir seed automatica (se habilitada no server).
NODE_ENV=development
DATABASE_URL=postgresql://cheiro3:cheiro3@localhost:5432/cheiro3?schema=public

# ===============================
# CENARIO 2: PRODUCAO
# ===============================
# Para producao, troque apenas estes valores:
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public

JWT_SECRET=change-me
PORT=3000
MENU_BASE_URL=https://menu.seudominio.com

# WhatsApp (Evolution API)
# URL publica da API para receber webhook: ex https://api.seudominio.com
WHATSAPP_WEBHOOK_BASE_URL=

# Opcional: customizar rotas da Evolution se sua versao for diferente
EVOLUTION_CREATE_PATH=/instance/create
EVOLUTION_CONNECT_PATH=/instance/connect/{instanceName}
EVOLUTION_DISCONNECT_PATH=/instance/logout/{instanceName}
EVOLUTION_SEND_TEXT_PATH=/message/sendText/{instanceName}
